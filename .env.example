# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# Never commit the .env file with real credentials!

# ======================
# Groq API Configuration
# ======================
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ======================
# Neo4j Configuration (Optional - for notebook)
# ======================
# Only needed if running the Jupyter notebook from scratch
NEO4J_URI=neo4j+s://your-database-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# ======================
# Application Configuration
# ======================
# Port for Streamlit application (default: 8502)
STREAMLIT_PORT=8502

# Server address (default: localhost)
STREAMLIT_SERVER_ADDRESS=localhost

# ======================
# Model Configuration
# ======================
# LLM model to use (default: llama-3.3-70b-versatile)
LLM_MODEL=llama-3.3-70b-versatile

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0

# Number of triplets to retrieve (default: 500)
RETRIEVAL_TOP_K=500

# ======================
# File Paths (Optional)
# ======================
# Path to model files (if not in root directory)
# TRIPLET_SENTENCES_PATH=./triplet_sentences.pkl
# TRIPLET_EMBEDDINGS_PATH=./triplet_embeddings.pkl

# ======================
# Logging Configuration (Optional)
# ======================
# LOG_LEVEL=INFO
# LOG_FILE=app.log
